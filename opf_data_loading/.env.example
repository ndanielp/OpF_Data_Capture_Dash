# OpF Data Loading — Configuração
# Copie para .env e preencha os valores

# ── Google Drive ──────────────────────────────────────────────────────────────
# ID da pasta no Google Drive onde os CSVs e logs serão salvos.
# Encontre na URL do Drive: https://drive.google.com/drive/folders/XXXX
DRIVE_FOLDER_ID=

# Caminho para o JSON da Service Account (relativo ao diretório opf_data_loading/)
# Padrão: credentials/service_account.json
SERVICE_ACCOUNT_FILE=credentials/service_account.json

# ── Caminhos locais ────────────────────────────────────────────────────────────
# Diretório local para logs (relativo ao diretório opf_data_loading/)
LOCAL_LOG_DIR=logs

# Caminho do banco SQLite
DB_PATH=data/consents.db

# ── Coleta ─────────────────────────────────────────────────────────────────────
# Número de browsers paralelos (reduza para 1-2 se receber erros 403 CloudFront)
DEFAULT_WORKERS=4

# ── Browser (opcional) ─────────────────────────────────────────────────────────
# Caminho do executável Chromium (auto-detectado se omitido)
# CHROMIUM_BIN=/usr/bin/chromium

# Proxy HTTP/HTTPS (opcional)
# HTTPS_PROXY=http://user:pass@host:port
