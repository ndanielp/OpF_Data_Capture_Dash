FROM alpine:3.23

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Usa pacotes pré-compilados do Alpine — sem pip, build mais rápido
RUN apk add --no-cache \
    python3 \
    py3-pandas \
    py3-fastapi \
    py3-uvicorn \
    py3-colorama

WORKDIR /app

COPY . .
RUN mkdir -p data logs credentials

CMD ["python3", "main.py", "dashboard", "--port", "8000"]
