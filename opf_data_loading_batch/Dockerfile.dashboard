FROM alpine:3.23

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Usa pacotes pré-compilados do Alpine — sem pip, build mais rápido
RUN apk add --no-cache \
    python3 \
    py3-pip \
    py3-pandas \
    py3-fastapi \
    py3-colorama \
    && pip3 install --no-cache-dir --break-system-packages "uvicorn>=0.22.0"

WORKDIR /app

COPY . .
RUN mkdir -p data logs credentials

CMD ["python3", "main.py", "dashboard", "--port", "8000"]
